{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/saro-saravanan/ai-workforce-sim/scenarios/schema.json",
  "title": "AI Workforce Sim scenario (v0.2 draft, for review)",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "name"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "enum": [
        "0.2",
        "0.3"
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
    },
    "name": {
      "type": "string",
      "maxLength": 120
    },
    "description": {
      "type": "string"
    },
    "parent": {
      "type": [
        "string",
        "null"
      ],
      "description": "Scenario id to inherit from; null only for baseline. Scalars and objects deep-merge over the parent; shocks are keyed by id (same id replaces the parent's shock); remove_shocks drops parent shocks by id; overrides merge by parameter id."
    },
    "created": {
      "type": "string",
      "format": "date-time"
    },
    "author": {
      "type": "string"
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "default": 42
    },
    "draws": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2000,
      "default": 200
    },
    "horizon": {
      "type": "object",
      "properties": {
        "start": {
          "type": "string",
          "pattern": "^20[0-9]{2}Q[1-4]$",
          "default": "2024Q1"
        },
        "end": {
          "type": "string",
          "pattern": "^20[0-9]{2}Q[1-4]$",
          "default": "2040Q4"
        }
      }
    },
    "levers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "capability": {
          "type": "object",
          "properties": {
            "doubling_months": {
              "type": "number",
              "minimum": 2,
              "maximum": 36
            },
            "doubling_drift_per_year": {
              "type": "number",
              "minimum": -0.5,
              "maximum": 0.5
            },
            "feedback_from_revenue": {
              "type": "boolean",
              "default": false
            },
            "robotics_doubling_months": {
              "type": "number",
              "minimum": 6,
              "maximum": 96
            },
            "per_actor": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "frontier_lag_quarters": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 16
                  },
                  "releases_per_year": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 12
                  },
                  "weights": {
                    "enum": [
                      "closed",
                      "open-lagged",
                      "open-frontier"
                    ]
                  },
                  "price_decline_per_year": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 100
                  }
                }
              }
            },
            "ever_automatable_scale": {
              "type": "number",
              "minimum": 0.5,
              "maximum": 1.5,
              "description": "Multiplies P.20-P.22 (ever-automatable mass by exposure class)."
            },
            "domain_transfer": {
              "type": "object",
              "properties": {
                "other_cognitive": {
                  "type": "number",
                  "minimum": 0.4,
                  "maximum": 1.0
                },
                "interpersonal": {
                  "type": "number",
                  "minimum": 0.2,
                  "maximum": 0.8
                }
              },
              "description": "P.34: fraction of software-task progress that transfers to other modalities."
            },
            "clock_saturation_doublings": {
              "type": "number",
              "minimum": 14,
              "maximum": 24
            }
          }
        },
        "cost": {
          "type": "object",
          "properties": {
            "price_decline_per_year": {
              "type": "number",
              "minimum": 1,
              "maximum": 100
            },
            "open_weights_multiplier": {
              "type": "number",
              "minimum": 0.05,
              "maximum": 1
            },
            "cost_floor_decline_per_year": {
              "type": "number",
              "minimum": 1,
              "maximum": 5
            },
            "compute_capacity_constraint": {
              "type": "boolean",
              "default": true
            },
            "capacity_price_exponent": {
              "type": "number",
              "minimum": 0.5,
              "maximum": 2
            },
            "token_growth_per_doubling": {
              "type": "number",
              "minimum": 0.4,
              "maximum": 1.0
            }
          }
        },
        "regulation": {
          "type": "object",
          "properties": {
            "EU": {
              "type": "object",
              "properties": {
                "ai_act": {
                  "enum": [
                    "repealed",
                    "baseline",
                    "delayed_2y",
                    "strict_original_2026"
                  ],
                  "description": "baseline = Reg. (EU) 2026/1744 timetable (Annex III 2 Dec 2027, Annex I 2 Aug 2028); delayed_2y = a further two-year delay; strict_original_2026 = original 2 Aug 2026 timetable."
                },
                "data_localization": {
                  "enum": [
                    "none",
                    "partial",
                    "full"
                  ]
                }
              }
            },
            "US": {
              "type": "object",
              "properties": {
                "regime": {
                  "enum": [
                    "none",
                    "state_patchwork",
                    "federal_light",
                    "federal_strict"
                  ]
                }
              }
            },
            "CN": {
              "type": "object",
              "properties": {
                "licensing": {
                  "enum": [
                    "liberalized",
                    "baseline",
                    "tightened"
                  ]
                }
              }
            },
            "export_controls": {
              "enum": [
                "rescinded",
                "2026_status_quo",
                "tightened"
              ]
            }
          }
        },
        "adoption": {
          "type": "object",
          "properties": {
            "sector_friction_scale": {
              "type": "number",
              "minimum": 0.25,
              "maximum": 4
            },
            "small_firm_friction_scale": {
              "type": "number",
              "minimum": 0.25,
              "maximum": 4
            },
            "intensity_ceiling": {
              "type": "number",
              "minimum": 0.1,
              "maximum": 1
            },
            "spillover_lag_quarters": {
              "type": "number",
              "minimum": 0,
              "maximum": 16
            },
            "per_sector": {
              "type": "object",
              "additionalProperties": {
                "type": "number",
                "minimum": 0.1,
                "maximum": 4
              }
            },
            "entrant_scale": {
              "type": "number",
              "minimum": 0,
              "maximum": 3,
              "description": "Scales AI-native entrant adoption (P.52)."
            }
          }
        },
        "labor": {
          "type": "object",
          "properties": {
            "reinstatement_ratio": {
              "type": "number",
              "minimum": 0,
              "maximum": 1.5
            },
            "demand_elasticity_scale": {
              "type": "number",
              "minimum": 0.25,
              "maximum": 3
            },
            "layoff_friction": {
              "type": "number",
              "minimum": 0.02,
              "maximum": 1
            },
            "price_pass_through": {
              "type": "number",
              "minimum": 0.3,
              "maximum": 1.0,
              "description": "P.53"
            },
            "occupational_attrition_pct_per_quarter": {
              "type": "number",
              "minimum": 1.5,
              "maximum": 3.5,
              "description": "P.63"
            },
            "wage_pass_through": {
              "type": "number",
              "minimum": 0.1,
              "maximum": 0.6,
              "description": "P.74"
            },
            "layoff_first_share": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Share of each quarter's required headcount reduction that employers take as layoffs at once, before attrition (0 = the spec's attrition-first rule; the 2025-2026 wave of AI-cited cuts suggests a positive value)."
            }
          }
        },
        "policy": {
          "type": "object",
          "description": "Keyed by region id (US, EU, UK, CN, JP, KR, IN, TW, SG, RoA).",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "retraining_subsidy_pct_wage": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "wage_insurance_replacement": {
                "type": "number",
                "minimum": 0,
                "maximum": 0.5
              },
              "wage_insurance_years": {
                "type": "number",
                "minimum": 0,
                "maximum": 5
              },
              "ubi_monthly_usd": {
                "type": "number",
                "minimum": 0,
                "maximum": 3000
              },
              "ai_tax_pct_of_ai_spend": {
                "type": "number",
                "minimum": 0,
                "maximum": 50
              },
              "work_week_hours": {
                "type": "number",
                "minimum": 28,
                "maximum": 40
              },
              "immigration_scale": {
                "type": "number",
                "minimum": 0,
                "maximum": 3
              },
              "financing": {
                "type": "object",
                "description": "Financing rule per policy; defaults: retraining=deficit, wage_insurance=ai_tax, ubi=ai_tax.",
                "properties": {
                  "retraining": {
                    "enum": [
                      "deficit",
                      "ai_tax",
                      "income_tax_surcharge"
                    ]
                  },
                  "wage_insurance": {
                    "enum": [
                      "deficit",
                      "ai_tax",
                      "income_tax_surcharge"
                    ]
                  },
                  "ubi": {
                    "enum": [
                      "deficit",
                      "ai_tax",
                      "income_tax_surcharge"
                    ]
                  },
                  "work_week": {
                    "enum": [
                      "deficit",
                      "ai_tax",
                      "income_tax_surcharge"
                    ]
                  }
                }
              }
            }
          }
        },
        "baseline": {
          "type": "object",
          "properties": {
            "bls_ai_adjustment": {
              "enum": [
                "restore_trend",
                "keep_projection"
              ],
              "default": "restore_trend"
            },
            "automation_trend": {
              "type": "number",
              "minimum": 0.5,
              "maximum": 1.5,
              "default": 1.0
            }
          }
        },
        "applications": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "embodiment": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "driving_doubling_months": {
                  "type": "number",
                  "minimum": 6,
                  "maximum": 48
                },
                "manipulation_doubling_months": {
                  "type": "number",
                  "minimum": 6,
                  "maximum": 48
                },
                "fixed_doubling_months": {
                  "type": "number",
                  "minimum": 6,
                  "maximum": 60
                },
                "aerial_doubling_months": {
                  "type": "number",
                  "minimum": 6,
                  "maximum": 48
                },
                "manipulation_automatable_share": {
                  "type": "number",
                  "minimum": 0.3,
                  "maximum": 0.85,
                  "description": "Share of mobile-manipulation task-hours that can ever be automated (P.101 central 0.6); the RethinkX humanoid claims need the top of the range."
                },
                "coupling_to_software": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 0.7
                }
              }
            },
            "hardware": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "learning_rate": {
                  "type": "number",
                  "minimum": 0.05,
                  "maximum": 0.25
                },
                "utilization_scale": {
                  "type": "number",
                  "minimum": 0.4,
                  "maximum": 1.6
                },
                "unit_price_scale": {
                  "type": "number",
                  "minimum": 0.5,
                  "maximum": 2.0
                },
                "ramp_max_growth_per_year": {
                  "type": "number",
                  "minimum": 0.3,
                  "maximum": 1.5
                }
              }
            },
            "approval": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "US": {
                  "enum": [
                    "frozen",
                    "baseline",
                    "accelerated",
                    "moratorium"
                  ]
                },
                "EU": {
                  "enum": [
                    "frozen",
                    "baseline",
                    "accelerated",
                    "moratorium"
                  ]
                },
                "UK": {
                  "enum": [
                    "frozen",
                    "baseline",
                    "accelerated",
                    "moratorium"
                  ]
                },
                "CN": {
                  "enum": [
                    "frozen",
                    "baseline",
                    "accelerated",
                    "moratorium"
                  ]
                },
                "JP": {
                  "enum": [
                    "frozen",
                    "baseline",
                    "accelerated",
                    "moratorium"
                  ]
                },
                "KR": {
                  "enum": [
                    "frozen",
                    "baseline",
                    "accelerated",
                    "moratorium"
                  ]
                },
                "IN": {
                  "enum": [
                    "frozen",
                    "baseline",
                    "accelerated",
                    "moratorium"
                  ]
                },
                "TW": {
                  "enum": [
                    "frozen",
                    "baseline",
                    "accelerated",
                    "moratorium"
                  ]
                },
                "SG": {
                  "enum": [
                    "frozen",
                    "baseline",
                    "accelerated",
                    "moratorium"
                  ]
                },
                "RoA": {
                  "enum": [
                    "frozen",
                    "baseline",
                    "accelerated",
                    "moratorium"
                  ]
                }
              }
            },
            "induced_demand_scale": {
              "type": "number",
              "minimum": 0,
              "maximum": 2,
              "description": "Scales each application's own induced-demand elasticity (eta_app, the Seba 'transport as a service' effect) beyond the sector elasticity; 0 = none, 1 = as catalogued."
            },
            "platform_labor": {
              "enum": [
                "status_quo",
                "employee_reclassification"
              ]
            },
            "content": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "authenticity": {
                  "enum": [
                    "persistent",
                    "eroding"
                  ]
                },
                "authenticity_level_scale": {
                  "type": "number",
                  "minimum": 0.2,
                  "maximum": 3.0
                },
                "licensing_regime": {
                  "enum": [
                    "permissive",
                    "licensed",
                    "restrictive"
                  ]
                },
                "price_sensitivity": {
                  "type": "number",
                  "minimum": 1.0,
                  "maximum": 4.0
                }
              }
            },
            "trade": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "services_exposure_scale": {
                  "type": "number",
                  "minimum": 0.0,
                  "maximum": 2.0
                }
              }
            },
            "enabled": {
              "type": "boolean",
              "default": true
            }
          }
        }
      }
    },
    "shocks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "at"
        ],
        "properties": {
          "type": {
            "enum": [
              "approval_change",
              "content_licensing_ruling",
              "frontier_breakthrough",
              "hardware_recall",
              "lab_exit",
              "open_weights_release",
              "production_shock",
              "recession",
              "supply_chain_cut"
            ]
          },
          "at": {
            "type": "string",
            "pattern": "^20[0-9]{2}Q[1-4]$"
          },
          "actor": {
            "type": "string"
          },
          "delta_doublings": {
            "type": "number",
            "minimum": 0,
            "maximum": 6
          },
          "frontier_lag_quarters": {
            "type": "number",
            "minimum": 0,
            "maximum": 8
          },
          "duration_quarters": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          },
          "severity": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "depth": {
            "type": "number",
            "minimum": -0.15,
            "maximum": 0
          },
          "region": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
          },
          "cls": {
            "enum": [
              "driving",
              "manip",
              "fixed",
              "aerial"
            ]
          },
          "full_year": {
            "type": "integer",
            "minimum": 2024,
            "maximum": 2045
          },
          "j_full": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "cap_multiplier": {
            "type": "number",
            "minimum": 0,
            "maximum": 2
          },
          "regime": {
            "enum": [
              "permissive",
              "licensed",
              "restrictive"
            ]
          }
        }
      }
    },
    "overrides": {
      "type": "object",
      "description": "Direct parameter overrides by registry id, e.g. \"P.61\".",
      "propertyNames": {
        "pattern": "^P\\.[0-9]{2}$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "central": {
            "type": "number"
          },
          "min": {
            "type": "number"
          },
          "max": {
            "type": "number"
          },
          "by": {
            "type": "object",
            "description": "Optional per-index override (sector, region, cohort)."
          }
        }
      }
    },
    "remove_shocks": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Ids of parent shocks to drop."
    },
    "ensemble": {
      "type": "object",
      "properties": {
        "mechanisms": {
          "enum": [
            "all",
            "central"
          ],
          "default": "all",
          "description": "all = 2x2x2 structural ensemble (spec 7.2); central = single mechanism set."
        },
        "shapley": {
          "type": "boolean",
          "default": false,
          "description": "Run Shapley channel attribution as a background job."
        }
      }
    },
    "preset": {
      "type": "boolean",
      "default": false,
      "description": "Report-replication preset (spec \u00a78.4)."
    },
    "user": {
      "type": "boolean",
      "default": false,
      "description": "Saved by a user through the API; lives in scenarios/user/."
    }
  }
}
